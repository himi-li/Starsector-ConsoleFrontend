# 构建产物
build/
*.class
# 注意：jars/ConsoleFrontend.jar 刻意纳入版本库，
# 这样用户克隆仓库后即可直接放入 mods/ 使用，无需自备 JDK。
# 发行包（Release）另行附带 zip。

# 编辑器 / 系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 本地临时文件
*.log
*.tmp
*.bak

# 可恢复的本地暂存（删除前先移入这里，不进版本库）
_trash/

# 本机构建路径覆盖（含本机绝对路径，禁止提交）
.build.local.ps1

# 发行包暂存目录（zip 通过 GitHub Release 分发，不进版本库）
_release/
